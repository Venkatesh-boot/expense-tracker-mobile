{
  "expo": {
    "name": "Family Expense Tracker",
    "slug": "family-expense-tracker",
    "scheme": "familytracker",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.oneeye.familytracker",
      "supportsTablet": true
    },
    "android": {
      "package": "com.oneeye.familytracker",
      "adaptiveIcon": {
        "backgroundColor": "#102A71",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Family Expense Tracker to choose a receipt image for on-device scanning.",
          "cameraPermission": "Allow Family Expense Tracker to take a receipt photo for on-device scanning.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ]
  }
}
