{
  "compilerOptions": {
    "strict": true,
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": ".test-dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "src/domain.ts",
    "src/dashboardUtils.ts",
    "src/receiptParser.ts",
    "src/transferUtils.ts",
    "src/reportUtils.ts",
    "tests/**/*.ts"
  ]
}
